{
  "name": "emoji-composer",
  "version": "1.1.2",
  "description": "A searchable React emoji composer by Cursor Style with original 3D emoji artwork and skin-tone variants.",
  "author": "Cursor Style",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css", "./dist/element.js", "./dist/element.cjs"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./catalog": "./data/emojis.json",
    "./tone-variants": "./data/tone-variants.json",
    "./tone-aliases": "./data/tone-aliases.json"
  },
  "files": ["dist", "data", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "https://github.com/wonchoe/emoji-composer.git"
  },
  "homepage": "https://cursor.style/emoji/",
  "bugs": {
    "url": "https://github.com/wonchoe/emoji-composer/issues"
  },
  "keywords": [
    "emoji",
    "emoji-picker",
    "emoji-composer",
    "react",
    "emoji-catalog",
    "skin-tone"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "dev": "vite --config vite.config.ts",
    "build:site": "vite build --config vite.config.ts --base=/emoji/ && node tools/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
